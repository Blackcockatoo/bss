NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_AUTH=false

# --- Product surface / domain separation --------------------------------
# A single deployment serves both public products; the active surface is
# resolved per-request from the hostname (see src/lib/domain/surface.ts).
NEXT_PUBLIC_SCHOOL_DOMAIN=metapet.school
NEXT_PUBLIC_STUDIO_DOMAIN=bluesnakestudios.com
# Local dev / preview only: force a surface without editing source.
# Ignored in production so a query/env value can never bypass school safety.
# One of: school | studio. You can also append ?surface=school in dev.
NEXT_PUBLIC_DEV_SURFACE=

# Legacy single-surface deployment switch. When set to "schools" the whole
# build is forced to the school surface on every host (standalone pilot).
# Leave unset for the combined two-domain deployment.
NEXT_PUBLIC_APP_PROFILE=
NEXT_PUBLIC_CHILD_SAFE_BASELINE=false

NEXT_PUBLIC_ENABLE_MAPS=false
NEXT_PUBLIC_FRONTEND_FORGE_API_KEY=
NEXT_PUBLIC_FRONTEND_FORGE_API_URL=
NEXT_STATIC_EXPORT=false
ALLOWED_FRAME_ANCESTORS='self'
STUDENT_DEPLOYMENT=true
